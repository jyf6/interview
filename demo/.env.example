# 银发传记 Demo 环境配置
# 复制此文件为 .env 并填入真实值

# DashScope (阿里千问) API 配置
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 模型参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# 服务端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 会话过期时间（秒）
SESSION_TTL_SECONDS=604800